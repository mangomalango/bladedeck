{
  "name": "bladedeck",
  "version": "0.2.3",
  "description": "One launcher for Steam, emulators, recompiled ports and any program. Console mode and PC mode.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "node scripts/predist.js && node scripts/buildinfo.js && electron-builder",
    "snapshot": "node scripts/snapshot.js",
    "rollback": "node scripts/rollback.js",
    "check": "node scripts/check.js && node scripts/spec.js",
    "test-pool": "node scripts/pooltest.js",
    "spec": "node scripts/spec.js",
    "sweep": "node scripts/sweep.js",
    "test-copy": "node scripts/testcopy.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "dev.bladedeck.app",
    "productName": "Bladedeck",
    "files": [
      "main.js",
      "discord.js",
      "adblock.js",
      "online.js",
      "store.js",
      "wallpaper.js",
      "voice-worker.js",
      "voice.js",
      "fsaccess.js",
      "lan.js",
      "system.js",
      "storage.js",
      "companion/**",
      "companion.js",
      "players.js",
      "extras.js",
      "roms.js",
      "achievements.js",
      "gamemusic.js",
      "savestates.js",
      "realdebrid.js",
      "capture.js",
      "livecap.js",
      "webdl.js",
      "finder.js",
      "minecraft.js",
      "backup.js",
      "winaudio.js",
      "winpad.js",
      "winlist.js",
      "wincapture.js",
      "updater.js",
      "feedback.js",
      "phonemsg.js",
      "bubble-preload.js",
      "build-info.json",
      "webapp-preload.js",
      "webapps.js",
      "procs.js",
      "peek.js",
      "net.js",
      "moonlight.js",
      "onlinemedia.js",
      "gameinfo.js",
      "archive.js",
      "romsync.js",
      "netshare.js",
      "steaminput.js",
      "bluetooth.js",
      "steamlink.js",
      "preload.js",
      "renderer/**",
      "themes/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "companion/icon-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "companion/icon-512.png"
    },
    "mac": {
      "target": "dmg"
    },
    "asarUnpack": [
      "node_modules/sherpa-onnx/**",
      "node_modules/seek-bzip/**"
    ],
    "icon": "companion/icon-512.png"
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "qrcode-generator": "^1.4.4",
    "seek-bzip": "^2.0.0",
    "sherpa-onnx": "^1.13.8"
  }
}
