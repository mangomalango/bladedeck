{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node scripts/snapshot.js \"start of Claude Code session\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Saving a git snapshot of Bladedeck"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./node_modules/**)",
      "Read(./dist/**)",
      "Read(./dist-electron/**)",
      "Read(./release/**)",
      "Read(./build/**)",
      "Read(./out/**)",
      "Read(./.vite/**)",
      "Read(./.cache/**)",
      "Read(./**/package-lock.json)",
      "Read(./**/yarn.lock)",
      "Read(./**/pnpm-lock.yaml)",
      "Read(./**/bun.lockb)",
      "Read(./**/*.log)",
      "Read(./**/*.asar)",
      "Read(./**/*.AppImage)",
      "Read(./**/*.exe)",
      "Read(./**/*.dmg)"
    ]
  }
}
